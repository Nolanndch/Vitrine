{
  "name": "takuzo",
  "version": "1.0.0",
  "description": "Studio Takuzo — boutiques Shopify & sites web sur mesure",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "i18n": "python3 i18n/build_en.py",
    "build": "python3 i18n/build_en.py && tailwindcss -i ./src/input.css -o ./css/style.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./css/style.css --watch"
  },
  "keywords": [
    "shopify",
    "streetwear",
    "drops",
    "web-design",
    "takuzo"
  ],
  "author": "Nolann Duchaussoy",
  "license": "ISC",
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
